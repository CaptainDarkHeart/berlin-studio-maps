{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "berlin-studio-maps",
	"account_id": "cd625a8a773318340cd24e10532aa135",
	"compatibility_date": "2026-09-08",
	"workers_dev": true,
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "berlinstudiomaps.com", "custom_domain": true },
		{ "pattern": "www.berlinstudiomaps.com", "custom_domain": true },
		{ "pattern": "berlinstudiomap.com", "custom_domain": true },
		{ "pattern": "www.berlinstudiomap.com", "custom_domain": true }
	],
	"analytics_engine_datasets": [
		{ "binding": "ANALYTICS", "dataset": "eventmap_events" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "berlin-studio-suggestions",
			"database_id": "d6cd0950-bb8d-4943-ab0f-858221ea327c"
		}
	],
	"vars": {
		"TURNSTILE_SITEKEY": "0x4AAAAAAEspIHOLsileoj7J"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
