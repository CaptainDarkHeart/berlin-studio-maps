---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
}
const { title, description, canonical, type = 'website' } = Astro.props;
const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Berlin Studio Map",
  "url": "https://berlinstudiomaps.com/",
  "description": "A free, independent directory of photography studios for hire in Berlin.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": "https://berlinstudiomaps.com/studios/?q={search_term_string}" },
    "query-input": "required name=search_term_string"
  }
};
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Berlin Studio Map",
  "url": "https://berlinstudiomaps.com/",
  "logo": "https://berlinstudiomaps.com/favicon.jpg",
  "email": "hello@berlinstudiomaps.com",
  "founder": {
    "@type": "Person",
    "name": "Beto Ruiz Alonso",
    "url": "https://www.betoruizalonso.com/about/",
    "sameAs": ["https://www.instagram.com/betoruizalonso/"]
  }
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow">
<link rel="canonical" href={canonical}>
<link rel="shortcut icon" href="/favicon.ico">
<link rel="icon" type="image/jpeg" href="/favicon.jpg">
<meta name="theme-color" content="#000000">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="Berlin Studio Map">
<meta property="og:image" content="https://berlinstudiomaps.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://berlinstudiomaps.com/og-image.png">
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary">
<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Sans+Caption:wght@400;700&family=PT+Mono&display=swap" rel="stylesheet">
<script>
(function(){var s=localStorage.getItem('sm_theme');if(s){document.documentElement.className=s;return;}var d=new Date(),doy=Math.floor((d-new Date(d.getFullYear(),0,1))/864e5)+1;var dec=23.45*Math.sin((360/365*(doy-81))*Math.PI/180);var cosH=-Math.tan(52.5200*Math.PI/180)*Math.tan(dec*Math.PI/180);var H=Math.abs(cosH)>=1?0:Math.acos(cosH)*180/Math.PI;var dst=d.getMonth()>=2&&d.getMonth()<=9?1:0;var sr=12+dst-H/15,ss=12+dst+H/15;var h=d.getHours()+d.getMinutes()/60;document.documentElement.className=(h>=sr&&h<ss)?'light':'dark';})();
</script>
</head>
<body>
<header class="page-header">
  <div class="logo"><a href="/">BERLIN STUDIO<span>map</span></a></div>
  <nav>
    <a href="/">Map</a>
    <a href="/studios/">Studios</a>
    <a href="/suggest/">Add Studio</a>
    <a href="/contact/">Contact</a>
    <a href="/about/">About</a>
    <a href="/blog/">Blog</a>
  </nav>
  <div class="header-right">
    <button class="theme-toggle" id="theme-toggle" title="Toggle day/night mode"></button>
    <button class="hamburger" id="page-hamburger" aria-label="Menu">&#9776;</button>
  </div>
</header>
<div class="page-mobile-menu" id="page-mobile-menu">
  <div class="page-mobile-menu-header">
    <div class="logo"><a href="/">BERLIN STUDIO<span>map</span></a></div>
    <button class="page-mobile-menu-close" id="page-mobile-menu-close">&#215;</button>
  </div>
  <nav class="page-mobile-nav">
    <a href="/">Map</a>
    <a href="/studios/">All Studios</a>
    <a href="/suggest/">Add Studio</a>
    <a href="/contact/">Contact</a>
    <a href="/about/">About</a>
    <a href="/blog/">Blog</a>
  </nav>
</div>
<script>
(function(){
  var h=document.getElementById('page-hamburger'),m=document.getElementById('page-mobile-menu'),c=document.getElementById('page-mobile-menu-close');
  if(h)h.addEventListener('click',function(){m.classList.add('open')});
  if(c)c.addEventListener('click',function(){m.classList.remove('open')});
  var t=document.getElementById('theme-toggle');
  if(t)t.addEventListener('click',function(){var d=document.documentElement,l=d.classList.contains('light');d.classList.toggle('light',!l);d.classList.toggle('dark',l);localStorage.setItem('sm_theme',l?'dark':'light');});
})();
</script>
<slot />
<footer>
  <p>&copy; 2026 Berlin Studio Map. A directory of photography studios for hire in Berlin.</p>
  <p style="margin-top:8px"><a href="/suggest/">Suggest a Studio</a> &middot; <a href="/contact/">Contact</a> &middot; <a href="/about/">About</a> &middot; <a href="/blog/">Blog</a></p>
</footer>
</body>
</html>
