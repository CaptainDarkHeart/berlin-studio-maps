<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
@font-face{font-family:'Alpaca Scarlett';src:url('/fonts/AlpacaScarlett.otf') format('opentype');font-weight:400;font-style:normal;font-display:swap}
:root{--bg:#000000;--surface:#161616;--surface-2:#222222;--border:#333333;--text:#ffffff;--text-dim:#9a9a9a;--accent:#a855f7;--accent-dim:#8b3ee0;--daylight:#c084fc;--ciclorama:#7eb8da;--green:#7ebd73;--red:#d47272;--font:'PT Sans',-apple-system,sans-serif;--mono:'PT Mono',monospace}
html.light{--bg:#ffffff;--surface:#f7f7f7;--surface-2:#ececec;--border:#dddddd;--text:#000000;--text-dim:#666666;--accent:#7c3aed;--accent-dim:#6d28d9;--daylight:#9333ea;--ciclorama:#2a6898;--green:#3a7a30;--red:#c04040}
body{font-family:var(--font);background:var(--bg);color:var(--text);height:100vh;overflow:hidden;display:flex;flex-direction:column;transition:background-color 2s ease,color 1s ease}
header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg);z-index:1000;flex-shrink:0;transition:background-color 2s ease,border-color 2s ease}
.logo{display:flex;align-items:baseline;gap:8px}
.logo a{text-decoration:none;color:inherit;display:flex;align-items:baseline;gap:8px}
.logo h1{font-size:19px;font-weight:400;font-family:'Alpaca Scarlett',var(--font);letter-spacing:0.01em}
.logo span{font-family:var(--mono);font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.08em}
nav{display:flex;align-items:center;gap:20px;justify-content:center}
nav a{font-family:'Alpaca Scarlett',var(--mono);font-size:13px;color:var(--text-dim);text-decoration:none;text-transform:uppercase;letter-spacing:0.06em;transition:color 0.15s}
nav a:hover{color:var(--text)}
.header-right{display:flex;align-items:center;gap:12px;justify-content:flex-end}
.studio-count{font-family:var(--mono);font-size:12px;color:var(--text-dim)}
.studio-count strong{color:var(--accent);font-weight:500}
.theme-toggle{background:none;border:1px solid var(--border);color:var(--text-dim);font-size:14px;width:28px;height:28px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s;flex-shrink:0}
.theme-toggle:hover{border-color:var(--text-dim);color:var(--text)}
.main{display:flex;flex:1;overflow:hidden}
.sidebar{width:310px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--bg);overflow:hidden;transition:background-color 2s ease,border-color 2s ease}
.filters{padding:12px;border-bottom:1px solid var(--border);transition:border-color 2s ease}
.filters-header{font-size:13px;font-weight:600;letter-spacing:-0.01em;color:var(--text);margin-bottom:10px}
.filter-group{margin-bottom:10px}.filter-group:last-child{margin-bottom:0}
.filter-group h3{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);margin-bottom:7px}
.filter-tags{display:flex;flex-wrap:wrap;gap:5px}
.filter-tag{font-family:var(--mono);font-size:11px;padding:4px 9px;border-radius:3px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;transition:all 0.15s;user-select:none}
.filter-tag:hover{border-color:var(--text-dim);color:var(--text)}
.filter-tag.active{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.area-select{width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:13px;padding:6px 9px;border-radius:4px;outline:none;cursor:pointer}
.area-select:focus{border-color:var(--accent)}
.search-wrap{position:relative;margin-bottom:10px}
.search-input{width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:13px;padding:7px 30px 7px 9px;border-radius:4px;outline:none;margin-bottom:0;box-sizing:border-box}
.search-input::placeholder{color:var(--text-dim)}
.search-input:focus{border-color:var(--accent)}
.search-clear{position:absolute;right:7px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:16px;line-height:1;padding:2px;display:none}
.search-clear:hover{color:var(--text)}
.search-clear.visible{display:block}
.studio-list{flex:1;overflow-y:auto;padding:6px}
.studio-list::-webkit-scrollbar{width:4px}
.studio-list::-webkit-scrollbar-track{background:transparent}
.studio-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.studio-card{padding:10px;border-radius:5px;cursor:pointer;transition:background-color 0.15s,border-color 0.15s;border:1px solid transparent;margin-bottom:3px}
.studio-card:hover{background:var(--surface);border-color:var(--border)}
.studio-card.selected{background:var(--surface);border-color:var(--accent)}
.studio-card .name{font-size:14px;font-weight:600;margin-bottom:3px;display:flex;align-items:center;gap:5px}
.studio-card .area{font-family:var(--mono);font-size:11px;color:var(--text-dim);margin-bottom:5px}
.studio-card .tags{display:flex;flex-wrap:wrap;gap:3px}
.mini-tag{font-family:var(--mono);font-size:10px;padding:2px 6px;border-radius:2px;background:var(--surface-2);color:var(--text-dim);text-transform:uppercase;letter-spacing:0.04em}
.mini-tag.daylight{background:rgba(240,214,138,0.15);color:var(--daylight)}
.mini-tag.ciclorama{background:rgba(126,184,218,0.15);color:var(--ciclorama)}
html.light .mini-tag.daylight{background:rgba(180,120,0,0.1);color:var(--daylight)}
html.light .mini-tag.ciclorama{background:rgba(42,104,152,0.1);color:var(--ciclorama)}
.daylight-indicator{width:6px;height:6px;border-radius:50%;display:inline-block;flex-shrink:0}
.daylight-indicator.good{background:var(--green);box-shadow:0 0 5px rgba(126,189,115,0.4)}
.daylight-indicator.limited{background:var(--daylight);box-shadow:0 0 5px rgba(240,214,138,0.3)}
.daylight-indicator.poor{background:var(--red);box-shadow:0 0 5px rgba(212,114,114,0.3)}
.daylight-indicator.na{background:var(--text-dim);opacity:0.3}
.daylight-legend{display:flex;flex-wrap:wrap;gap:9px;padding:8px 12px;border-bottom:1px solid var(--border);font-family:var(--mono);font-size:10px;color:var(--text-dim)}
.daylight-legend span.label{display:inline-flex;align-items:center;gap:4px;margin-left:2px}
.map-container{flex:1;position:relative}
#map{width:100%;height:100%}
html.light .leaflet-container{background:#f7f7f7}
.leaflet-container{background:#161616}
.leaflet-control-zoom{border:1px solid var(--border)!important}
.leaflet-control-zoom a{background:var(--surface)!important;color:var(--text)!important;border-color:var(--border)!important}
.leaflet-control-zoom a:hover{background:var(--surface-2)!important}
.leaflet-control-attribution{background:rgba(14,14,14,0.8)!important;color:var(--text-dim)!important;font-size:9px!important}
html.light .leaflet-control-attribution{background:rgba(248,246,242,0.8)!important}
.leaflet-control-attribution a{color:var(--text-dim)!important}
.detail-panel{position:absolute;right:16px;top:16px;width:350px;max-height:calc(100% - 32px);background:var(--surface);border:1px solid var(--border);border-radius:8px;z-index:800;overflow-y:auto;display:none;box-shadow:0 20px 60px rgba(0,0,0,0.5);transition:background-color 2s ease,border-color 2s ease}
html.light .detail-panel{box-shadow:0 20px 60px rgba(0,0,0,0.15)}
.detail-panel.visible{display:block}
.detail-panel::-webkit-scrollbar{width:4px}
.detail-panel::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.detail-header{padding:16px;border-bottom:1px solid var(--border);position:relative}
.detail-close{position:absolute;top:12px;right:12px;width:26px;height:26px;border-radius:50%;border:1px solid var(--border);background:var(--surface-2);color:var(--text-dim);font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.detail-close:hover{border-color:var(--text-dim);color:var(--text)}
.detail-header h2{font-size:18px;font-weight:600;margin-bottom:4px;padding-right:32px}
.detail-header .detail-area{font-family:var(--mono);font-size:12px;color:var(--text-dim)}
.detail-body{padding:16px}
.detail-section{margin-bottom:16px}.detail-section:last-child{margin-bottom:0}
.detail-section h4{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);margin-bottom:6px}
.detail-features{display:flex;flex-wrap:wrap;gap:5px}
.feature-tag{font-family:var(--mono);font-size:11px;padding:4px 8px;border-radius:3px;background:var(--surface-2);color:var(--text)}
.feature-tag.highlight{background:rgba(232,168,73,0.15);color:var(--accent)}
html.light .feature-tag.highlight{background:rgba(196,120,32,0.12)}
.detail-stat{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--border);font-size:13px}
.detail-stat:last-child{border-bottom:none}
.detail-stat .label{color:var(--text-dim);font-size:12px}
.detail-stat .value{font-family:var(--mono);font-weight:500;font-size:13px}
.detail-stat .value.price{color:var(--accent)}
.daylight-chart{background:var(--surface-2);border-radius:5px;padding:12px}
.hours-bar{width:100%;height:20px;border-radius:3px;background:var(--surface);position:relative;overflow:hidden;margin-bottom:6px}
html.light .hours-bar{background:#ddd8d0}
.hours-bar .light-window{position:absolute;top:0;height:100%;border-radius:3px}
.hours-bar .golden-window{background:rgba(240,214,138,0.4)}
html.light .hours-bar .golden-window{background:rgba(180,120,0,0.25)}
.hours-bar .daylight-window{background:rgba(255,255,255,0.08)}
html.light .hours-bar .daylight-window{background:rgba(0,0,0,0.08)}
.daylight-meta{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9px;color:var(--text-dim)}
.website-link{display:inline-block;margin-top:10px;font-family:var(--mono);font-size:10px;color:var(--accent);text-decoration:none;border-bottom:1px solid transparent;transition:border-color 0.15s}
.website-link:hover{border-bottom-color:var(--accent)}
.verified-badge{font-family:var(--mono);font-size:8px;padding:1px 4px;border-radius:2px;background:rgba(126,189,115,0.15);color:var(--green);margin-left:4px}
.estimated-badge{font-family:var(--mono);font-size:8px;padding:1px 4px;border-radius:2px;background:rgba(138,134,128,0.15);color:var(--text-dim);margin-left:4px}
.hamburger{display:none}
.mobile-menu{display:none}
.mobile-shelf{display:none}
.filter-sheet{display:none}
@media(max-width:768px){
  header{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;padding-top:calc(10px + env(safe-area-inset-top))}
  nav{display:none}
  .studio-count{display:none}
  .header-right{gap:8px}
  .hamburger{display:flex;align-items:center;justify-content:center;background:none;border:1px solid var(--border);color:var(--text-dim);font-size:16px;width:32px;height:32px;border-radius:6px;cursor:pointer;transition:all 0.15s;flex-shrink:0}
  .hamburger:hover{border-color:var(--text-dim);color:var(--text)}
  .main{flex:1;overflow:hidden}
  .sidebar{display:none}
  .map-container{width:100%;height:100%}
  .leaflet-control-zoom{display:none!important}
  .detail-panel{position:fixed!important;bottom:0!important;left:0!important;right:0!important;top:auto!important;width:100%!important;max-height:52vh;min-height:40vh;border-radius:16px 16px 0 0!important;border-left:none;border-right:none;border-bottom:none;transform:translateY(100%);transition:transform 0.32s cubic-bezier(0.4,0,0.2,1),background-color 2s ease,border-color 2s ease;display:block!important;overflow-y:auto;z-index:950}
  .detail-panel.visible{transform:translateY(0)}
  .detail-panel-handle{display:flex;justify-content:center;padding:10px 0 4px}
  .detail-panel-handle-pill{width:36px;height:4px;background:var(--border);border-radius:2px}
  .mobile-menu{position:fixed;inset:0;background:var(--bg);z-index:1100;flex-direction:column;padding:20px;display:none;transition:background-color 2s ease}
  .mobile-menu.open{display:flex}
  .mobile-menu-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px}
  .mobile-menu-close{background:none;border:1px solid var(--border);color:var(--text-dim);font-size:18px;width:36px;height:36px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center}
  .mobile-nav{display:flex;flex-direction:column;gap:8px}
  .mobile-nav a{font-family:'Alpaca Scarlett',var(--font);font-size:28px;font-weight:600;color:var(--text);text-decoration:none;text-transform:uppercase;padding:8px 0;border-bottom:1px solid var(--border);transition:color 0.15s}
  .mobile-nav a:hover{color:var(--accent)}
  .mobile-shelf{display:flex;flex-direction:column;position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-radius:16px 16px 0 0;border-top:1px solid var(--border);z-index:900;max-height:72vh;transform:translateY(calc(100% - 64px));transition:transform 0.32s cubic-bezier(0.4,0,0.2,1),background-color 2s ease,border-color 2s ease;overflow:hidden}
  .mobile-shelf.open{transform:translateY(0)}
  .shelf-handle-area{display:flex;align-items:center;height:64px;padding:0 16px;cursor:pointer;flex-shrink:0;gap:12px;position:relative}
  .shelf-pill{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:36px;height:4px;background:var(--border);border-radius:2px}
  .shelf-count{font-family:var(--mono);font-size:12px;color:var(--text-dim);flex:1}
  .shelf-count strong{color:var(--accent);font-weight:500}
  .shelf-filter-btn{font-family:var(--mono);font-size:10px;padding:5px 10px;border-radius:4px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;transition:all 0.15s;text-transform:uppercase;letter-spacing:0.05em}
  .shelf-filter-btn.active{background:var(--accent);border-color:var(--accent);color:var(--bg)}
  .shelf-body{display:flex;flex-direction:column;flex:1;overflow:hidden;padding:0 12px 16px}
  .shelf-body .search-input{font-size:16px}
  .shelf-filters{margin-bottom:10px;padding-top:4px}
  .m-studio-list{flex:1;overflow-y:auto;padding:0 0 4px}
  .studio-card{padding:12px 10px}
  .studio-card .name{font-size:13px}
  .studio-card .area{font-size:11px}
  .filter-sheet{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-radius:16px 16px 0 0;border-top:1px solid var(--border);z-index:1000;transform:translateY(100%);transition:transform 0.32s cubic-bezier(0.4,0,0.2,1),background-color 2s ease,border-color 2s ease;max-height:70vh;overflow-y:auto}
  .filter-sheet.open{transform:translateY(0)}
  .filter-sheet-handle{display:flex;justify-content:center;padding:10px 0 4px}
  .filter-sheet-pill{width:36px;height:4px;background:var(--border);border-radius:2px}
  .filter-sheet-inner{padding:4px 20px 32px}
  .filter-sheet-done{font-family:var(--mono);font-size:11px;padding:5px 14px;border-radius:4px;background:var(--accent);border:none;color:var(--bg);cursor:pointer;font-weight:600}
  .shelf-filter-btn.has-filters{background:var(--accent);border-color:var(--accent);color:var(--bg)}
}
</style>
<script>
(function(){
  var stored=localStorage.getItem('sm_theme');
  if(stored){document.documentElement.className=stored;return;}
  function _calcSun(d: Date){
    var doy=Math.floor((+d-+new Date(d.getFullYear(),0,1))/864e5)+1;
    var dec=23.45*Math.sin((2*Math.PI/365)*(doy-81)*Math.PI/180);
    var latR=52.5200*Math.PI/180;
    var cosH=-Math.tan(latR)*Math.tan(dec*Math.PI/180);
    cosH=Math.max(-1,Math.min(1,cosH));
    var H=Math.acos(cosH)*180/Math.PI;
    var dst=d.getMonth()>=2&&d.getMonth()<=9?1:0;
    var noon=12+dst;
    return{sunrise:noon-H/15,sunset:noon+H/15};
  }
  var now=new Date(),t=_calcSun(now);
  var h=now.getHours()+now.getMinutes()/60+now.getSeconds()/3600;
  var isDay=h>=t.sunrise&&h<t.sunset;
  document.documentElement.classList.add(isDay?'light':'dark');
})();
</script>
</head>
