<nav>
<a href="/studios/">All Studios</a>
<a href="/suggest/">Add Studio</a>
<a href="/contact/">Contact</a>
<a href="/about/">About</a>
<a href="/blog/">Blog</a>
</nav>
<div class="header-right">
<div class="studio-count"><strong id="visible-count">0</strong> / <span id="total-count">0</span> studios</div>
<button class="theme-toggle" id="theme-toggle">☀</button>
<button class="hamburger" id="hamburger" aria-label="Menu">&#9776;</button>
</div>
</header>
<div class="mobile-menu" id="mobile-menu">
<div class="mobile-menu-header">
<div class="logo"><a href="/"><h1>BERLIN STUDIO</h1><span>map</span></a></div>
<button class="mobile-menu-close" id="mobile-menu-close">&#215;</button>
</div>
<nav class="mobile-nav">
<a href="/studios/" onclick="document.getElementById('mobile-menu').classList.remove('open')">All Studios</a>
<a href="/suggest/" onclick="document.getElementById('mobile-menu').classList.remove('open')">Add Studio</a>
<a href="/contact/" onclick="document.getElementById('mobile-menu').classList.remove('open')">Contact</a>
<a href="/about/" onclick="document.getElementById('mobile-menu').classList.remove('open')">About</a>
<a href="/blog/" onclick="document.getElementById('mobile-menu').classList.remove('open')">Blog</a>
</nav>
</div>
<div class="main">
<div class="sidebar">
<div id="viewport-hint" style="display:none;padding:8px 14px;font-size:11px;font-family:var(--mono);color:var(--text-dim);background:var(--surface-2);border-bottom:1px solid var(--border)"></div>
<div class="filters">
<div class="filters-header">Filter</div>
<div class="search-wrap"><input type="text" class="search-input" id="search-input" placeholder="Search studios..."/><button class="search-clear" id="search-clear" aria-label="Clear search">&times;</button></div>
<div class="filter-group">
<h3>Features</h3>
<div class="filter-tags">
<div class="filter-tag" data-filter="daylight">Daylight</div>
<div class="filter-tag" data-filter="blackout">Blackout</div>
<div class="filter-tag" data-filter="ciclorama">Cyclorama</div>
<div class="filter-tag" data-filter="driveIn">Drive-in</div>
</div>
</div>
<div class="filter-group">
<h3>Facilities</h3>
<div class="filter-tags">
<div class="filter-tag" data-filter="kitchen">Kitchen</div>
<div class="filter-tag" data-filter="makeup">Makeup</div>
