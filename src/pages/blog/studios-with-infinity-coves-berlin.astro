---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';
import { slugify } from '../../lib/slug';

const list = (studios as any[]).filter(s => s.cove).sort((a,b) => a.name.localeCompare(b.name));
---
<PageLayout
  title="Photography Studios with Infinity Coves in Berlin | Studio Map Berlin"
  description={`${list.length} studios with infinity coves in Berlin. Dimensions, pricing, and specs compared.`}
  canonical="https://berlinstudiomaps.io/blog/studios-with-infinity-coves-berlin/"
>
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Infinity Cove Studios</div>
  <h1>Photography Studios with Infinity Coves in Berlin</h1>
  <p>{list.length} studios on Studio Map Berlin have a dedicated infinity cove or cyclorama. Sizes range widely, check ceiling height and drive-in access if you're shooting vehicles or need headroom for lighting rigs.</p>

  <div class="studio-grid">
    {list.map((s: any) => (
      <a href={`/studios/${slugify(s)}/`} class="studio-link">
        <h3>{s.name}</h3>
        <div class="meta">{s.neighbourhood}, {s.area} Berlin · {s.rate}</div>
        {s.ceil && <div class="meta">Ceiling: {s.ceil}</div>}
        <div>{s.driveIn && <span class="tag highlight">Drive-in</span>}</div>
      </a>
    ))}
  </div>
</div>
</PageLayout>
