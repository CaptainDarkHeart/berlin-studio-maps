---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';
import { slugify } from '../../lib/slug';
import Faq from '../../components/Faq.astro';

const list = (studios as any[]).filter(s => s.ciclorama).sort((a,b) => a.name.localeCompare(b.name));
const title = "Photography Studios with Infinity Cycloramas in Berlin | Berlin Studio Map";
const description = `${list.length} studios with infinity cycloramas in Berlin. Dimensions, pricing, and specs compared.`;
const canonical = "https://berlinstudiomap.com/blog/studios-with-infinity-coves-berlin/";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Photography Studios with Infinity Cycloramas in Berlin",
  "description": description,
  "url": canonical,
  "author": [
    { "@type": "Person", "name": "Beto Ruiz Alonso", "url": "https://www.betoruizalonso.com/about/" },
    { "@type": "Person", "name": "Dan Taylor", "url": "https://dantaylor.me" }
  ],
  "datePublished": "2026-09-08",
  "dateModified": "2026-10-12",
  "inLanguage": "en-GB",
  "mainEntityOfPage": canonical,
  "image": "https://berlinstudiomap.com/og-image.png",
  "publisher": { "@type": "Organization", "name": "Berlin Studio Map", "url": "https://berlinstudiomap.com/", "logo": { "@type": "ImageObject", "url": "https://berlinstudiomap.com/favicon.jpg" } }
};
const faqs = [
  { q: "How many Berlin photography studios have an infinity cyclorama?", a: `${list.length} studios on Berlin Studio Map have a dedicated infinity cyclorama: ${list.map((s: any) => s.name).join(', ')}.` },
  { q: "Which Berlin cyclorama studios have drive-in access for cars?", a: `${list.filter((s: any) => s.driveIn).length} of the ${list.length} cyclorama studios offer drive-in vehicle access: ${list.filter((s: any) => s.driveIn).map((s: any) => s.name).join(', ')}.` },
  { q: "What should I check before booking a cyclorama studio?", a: "Cyclorama sizes vary widely. Check ceiling height for lighting rigs and headroom, and drive-in access if you are shooting vehicles." }
];
---
<PageLayout title={title} description={description} canonical={canonical} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Infinity Cyclorama Studios</div>
  <h1>Photography Studios with Infinity Cycloramas in Berlin</h1>
  <p>{list.length} studios on Berlin Studio Map have a dedicated infinity cyclorama. Sizes vary widely. Check ceiling height and drive-in access if you're shooting vehicles or need headroom for lighting rigs.</p>

  <div class="studio-grid">
    {list.map((s: any) => (
      <a href={`/studios/${slugify(s)}/`} class="studio-link">
        <h3>{s.name}</h3>
        <div class="meta">{s.neighbourhood}, {s.area} Berlin · {s.rate}</div>
        {s.ceil && <div class="meta">Ceiling: {s.ceil}</div>}
        <div>{s.driveIn && <span class="tag highlight">Drive-in</span>}</div>
      </a>
    ))}
  </div>
  <Faq items={faqs} />
</div>
</PageLayout>
