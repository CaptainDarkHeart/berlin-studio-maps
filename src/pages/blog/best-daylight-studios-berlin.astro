---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';
import { slugify } from '../../lib/slug';
import Faq from '../../components/Faq.astro';

const list = (studios as any[]).filter(s => s.daylight).sort((a,b) => a.name.localeCompare(b.name));
const title = "Best Daylight Photography Studios in Berlin | Berlin Studio Map";
const description = `${list.length} daylight studios for hire in Berlin. Compared by orientation and facilities.`;
const canonical = "https://berlinstudiomap.com/blog/best-daylight-studios-berlin/";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Best Daylight Photography Studios in Berlin",
  "description": description,
  "url": canonical,
  "author": [
    { "@type": "Person", "name": "Beto Ruiz Alonso", "url": "https://www.betoruizalonso.com/about/" },
    { "@type": "Person", "name": "Dan Taylor", "url": "https://dantaylor.me" }
  ],
  "datePublished": "2026-09-08",
  "dateModified": "2026-10-12",
  "inLanguage": "en-GB",
  "mainEntityOfPage": canonical,
  "image": "https://berlinstudiomap.com/og-image.png",
  "publisher": { "@type": "Organization", "name": "Berlin Studio Map", "url": "https://berlinstudiomap.com/", "logo": { "@type": "ImageObject", "url": "https://berlinstudiomap.com/favicon.jpg" } }
};
const faqs = [
  { q: "How many Berlin photography studios have natural daylight?", a: `${list.length} studios on Berlin Studio Map offer natural daylight.` },
  { q: "What matters most when choosing a daylight studio?", a: "Window orientation matters more than square footage. South-facing and skylight studios hold usable light longest through the day, especially in winter." },
  { q: "How much daylight do Berlin studios get in winter?", a: "Berlin's winter cuts daylight to 7 to 8 hours a day in December. Every studio page on Berlin Studio Map shows a daylight hours table by month." }
];
---
<PageLayout title={title} description={description} canonical={canonical} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Best Daylight Studios</div>
  <h1>Best Daylight Photography Studios in Berlin</h1>
  <p>{list.length} studios on Berlin Studio Map offer natural daylight. Window orientation matters more than square footage. South-facing and skylight studios hold usable light longest through the day, especially in winter.</p>

  <div class="studio-grid">
    {list.map((s: any) => (
      <a href={`/studios/${slugify(s)}/`} class="studio-link">
        <h3>{s.name}</h3>
        <div class="meta">{s.neighbourhood}, {s.area} Berlin · {s.rate}</div>
        {s.facing && <div class="meta">{s.facing}</div>}
      </a>
    ))}
  </div>
  <Faq items={faqs} />
</div>
</PageLayout>
