---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';

const total = studios.length;
const daylight = (studios as any[]).filter(s => s.daylight).length;
const ciclorama = (studios as any[]).filter(s => s.ciclorama).length;
const makeup = (studios as any[]).filter(s => s.makeup).length;
const greenRoom = (studios as any[]).filter(s => s.greenRoom).length;
const areas = new Set((studios as any[]).map(s => s.area)).size;
---
<PageLayout
  title="Blog | Berlin Studio Map"
  description="Guides, comparisons, and tips for finding the right photography studio in Berlin."
  canonical="https://berlinstudiomaps.com/blog/"
>
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / Blog</div>
  <h1>Blog</h1>
  <p>Guides, comparisons, and tips for finding the right photography studio in Berlin.</p>

  <div class="studio-grid">
    <a href="/blog/complete-guide-photography-studio-hire-berlin/" class="studio-link">
      <h3>The Complete Guide to Photography Studio Hire in Berlin</h3>
      <div class="meta">Everything you need to know. {total} studios compared across {areas} areas.</div>
    </a>
    <a href="/blog/best-daylight-studios-berlin/" class="studio-link">
      <h3>Best Daylight Photography Studios in Berlin</h3>
      <div class="meta">{daylight} daylight studios compared by orientation and facilities.</div>
    </a>
    <a href="/blog/studios-with-infinity-coves-berlin/" class="studio-link">
      <h3>Photography Studios with Infinity Cycloramas in Berlin</h3>
      <div class="meta">{ciclorama} studios with infinity cycloramas. Dimensions and specs compared.</div>
    </a>
    <a href="/blog/cheap-photography-studios-berlin/" class="studio-link">
      <h3>Cheap Photography Studios to Rent in Berlin</h3>
      <div class="meta">Studios renting for €50/hr or less, cheapest first.</div>
    </a>
    <a href="/blog/studios-with-makeup-room-berlin/" class="studio-link">
      <h3>Photography Studios with a Makeup Room in Berlin</h3>
      <div class="meta">{makeup} studios with a dedicated makeup or hair and makeup area.</div>
    </a>
    <a href="/blog/green-screen-vs-green-room-studios-berlin/" class="studio-link">
      <h3>Green Screen vs. Green Room Studios in Berlin</h3>
      <div class="meta">What each term actually means, and {greenRoom} studios with a private prep room.</div>
    </a>
  </div>
</div>
</PageLayout>
