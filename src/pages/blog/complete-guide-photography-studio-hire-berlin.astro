---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';
import { slugify } from '../../lib/slug';

const total = studios.length;
const areas = Array.from(new Set((studios as any[]).map(s => s.area))).sort();
const daylight = (studios as any[]).filter(s => s.daylight).length;
const ciclorama = (studios as any[]).filter(s => s.ciclorama).length;
const driveIn = (studios as any[]).filter(s => s.driveIn).length;
const title = "The Complete Guide to Photography Studio Hire in Berlin | Berlin Studio Map";
const description = `Everything you need to know about hiring a photography studio in Berlin. ${total} studios compared across ${areas.length} areas.`;
const canonical = "https://berlinstudiomaps.com/blog/complete-guide-photography-studio-hire-berlin/";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "The Complete Guide to Photography Studio Hire in Berlin",
  "description": description,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Berlin Studio Map" },
  "publisher": { "@type": "Organization", "name": "Berlin Studio Map" }
};
---
<PageLayout title={title} description={description} canonical={canonical} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Complete Guide</div>
  <h1>The Complete Guide to Photography Studio Hire in Berlin</h1>
  <p>Berlin runs from small daylight lofts in Kreuzberg to full production spaces with drive-in cycloramas out in Tempelhof and Lichtenberg. Here's what to look for, and where to find it.</p>

  <h2>What's on this site</h2>
  <p>{total} studios across {areas.length} areas: {areas.join(', ')}. {daylight} have natural daylight, {ciclorama} have an infinity cyclorama, and {driveIn} offer drive-in vehicle access.</p>

  <h2>Daylight vs. blackout</h2>
  <p>Daylight studios suit editorial and lifestyle work, but Berlin's winter cuts that light to 7 to 8 hours a day in December. Blackout studios give you full control year-round instead. Every studio page here shows a build-time daylight hours table by month, and the map's detail panel calculates that day's actual sunrise, sunset, and golden hour for the studio's location.</p>

  <h2>Infinity cycloramas</h2>
  <p>Need a seamless white or coloured background? Look for a cyclorama, not paper. Berlin studios with one <a href="/features/infinity-cyclorama-studios/">are listed here</a>, from tight 6x6m setups to full 10x10m cycloramas with drive-in access for car and motorbike shoots.</p>

  <h2>Browse by area</h2>
  <div class="studio-grid">
    {areas.map(a => (
      <a href={`/areas/${a.toLowerCase().replace(/[^a-z0-9]+/g,'-')}/`} class="studio-link">
        <h3>{a}</h3>
        <div class="meta">{(studios as any[]).filter(s => s.area === a).length} studios</div>
      </a>
    ))}
  </div>

  <p style="margin-top:24px"><a href="/studios/">See the full A–Z list →</a></p>
</div>
</PageLayout>
