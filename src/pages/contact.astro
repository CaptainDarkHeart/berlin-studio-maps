---
import PageLayout from '../layouts/PageLayout.astro';
const TURNSTILE_SITEKEY = '0x4AAAAAAEspIHOLsileoj7J';
---
<PageLayout
  title="Contact | Berlin Studio Map"
  description="Get in touch with Berlin Studio Map: questions, corrections, partnerships, or press."
  canonical="https://berlinstudiomaps.com/contact/"
>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / Contact</div>
  <h1>Contact</h1>
  <p>Questions, corrections, partnerships, or press enquiries, use the form below.</p>
  <p>Studio owner with a listing to add or fix? Use <a href="/suggest/">Suggest a Studio</a> instead, it routes straight to review.</p>

  <form id="contact-form">
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp-field" />

    <label>Name *<input type="text" name="name" required maxlength="120" /></label>
    <label>Email *<input type="email" name="email" required maxlength="200" /></label>
    <label>Message *<textarea name="message" required maxlength="2000" rows="6"></textarea></label>
    <label class="checkbox"><input type="checkbox" name="sendCopy" /> Send a copy of this to my email</label>

    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

    <button type="submit">Send message</button>
    <p id="contact-result" role="status"></p>
  </form>
</div>

<style>
  form { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; margin: 2rem 0; }
  form label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.95rem; }
  form label.checkbox { flex-direction: row; align-items: center; gap: 0.5rem; }
  form input[type="text"], form input[type="email"], form textarea { padding: 0.5rem; font: inherit; }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  form button { padding: 0.6rem 1.2rem; cursor: pointer; width: fit-content; }
  #contact-result { font-size: 0.9rem; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const resultEl = document.getElementById('contact-result') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    resultEl.textContent = 'Sending...';
    const fd = new FormData(form);
    if (String(fd.get('company') || '').trim() !== '') return;

    const payload = {
      company: fd.get('company'),
      name: fd.get('name'),
      email: fd.get('email'),
      message: fd.get('message'),
      sendCopy: fd.get('sendCopy') === 'on',
      turnstileToken: fd.get('cf-turnstile-response'),
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      resultEl.textContent = data.message || data.error || 'Something went wrong.';
      if (data.ok) form.reset();
    } catch {
      resultEl.textContent = 'Network error, please try again.';
    }
  });
</script>
</PageLayout>
