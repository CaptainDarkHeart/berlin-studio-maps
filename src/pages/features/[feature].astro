---
import PageLayout from '../../layouts/PageLayout.astro';
import studios from '../../data/studios.json';
import { slugify } from '../../lib/slug';
import { FEATURES } from '../../lib/features';

export function getStaticPaths() {
  return Object.keys(FEATURES).map(slug => ({
    params: { feature: slug },
    props: { slug, ...FEATURES[slug] },
  }));
}

const { slug, key, label, noun } = Astro.props;
const list = (studios as any[]).filter(s => s[key]).sort((a, b) => a.name.localeCompare(b.name));
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": list.map((s: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://berlinstudiomaps.com/studios/${slugify(s)}/`
  }))
};
---
<PageLayout
  title={`${label} in Berlin | Berlin Studio Map`}
  description={`${list.length} ${noun} for hire in Berlin.`}
  canonical={`https://berlinstudiomaps.com/features/${slug}/`}
>
<script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / {label}</div>

  <h1>{label} in Berlin</h1>
  <p>{list.length} {noun} for hire in Berlin.</p>

  <a href={`/?filter=${slug}`} class="cta-map">View on Map</a>

  <div class="studio-grid">
    {list.map((s: any) => (
      <a href={`/studios/${slugify(s)}/`} class="studio-link">
        <h3>{s.name}</h3>
        <div class="meta">{s.neighbourhood}, {s.area} Berlin · {s.rate}</div>
      </a>
    ))}
  </div>
</div>
</PageLayout>
